    "ABLATION_SAVE_DIR = BASE_SAVE / \"feature_ablation_results\"\n",
    "ABLATION_SAVE_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "feature_ablation_df.to_csv(ABLATION_SAVE_DIR / \"fold_level_feature_ablation.csv\", index=False)\n",
    "print(\"Saved fold-level feature ablation results.\")"
