     "output_type": "stream",
     "text": [
      "Official feature set frozen with 28 features.\n",
      "Train+Dev samples: 219 | Test samples: 56\n"
     ]
    }
   ],
   "source": "# =========================================================\n# LOAD FEATURE TABLES\n# Switch FEATURE_SET to choose which features to use:\n#   \"mfcc\"     \u2014 your original segment_*.csv (MFCCs + eGeMAPS volatility)\n#   \"merged\"   \u2014 merged E-DAIC + DAIC-WOZ segment_*.csv\n#   \"wav2vec2\" \u2014 deep wav2vec2 features (best UAR)\n#   \"combined\" \u2014 wav2vec2 + merged MFCC stacked (most features, try last)\n# =========================================================\n\nFEATURE_SET = \"wav2vec2\"   # \u2190 change this to switch feature sets\n\nBASE_SETS = {\n    \"mfcc\"     : (\"segment_train.csv\",        \"segment_dev.csv\",        \"segment_test.csv\"),\n    \"merged\"   : (\"merged_segment_train.csv\",  \"merged_segment_dev.csv\",  \"merged_segment_test.csv\"),\n    \"wav2vec2\" : (\"wav2vec2_segment_train.csv\",\"wav2vec2_segment_dev.csv\",\"wav2vec2_segment_test.csv\"),\n}\n\nif FEATURE_SET == \"combined\":\n    # Stack wav2vec2 + merged MFCC features horizontally\n    w2v_tr = pd.read_csv(BASE_SAVE / \"wav2vec2_segment_train.csv\")\n    w2v_dv = pd.read_csv(BASE_SAVE / \"wav2vec2_segment_dev.csv\")\n    w2v_te = pd.read_csv(BASE_SAVE / \"wav2vec2_segment_test.csv\")\n    mfc_tr = pd.read_csv(BASE_SAVE / \"merged_segment_train.csv\")\n    mfc_dv = pd.read_csv(BASE_SAVE / \"merged_segment_dev.csv\")\n    mfc_te = pd.read_csv(BASE_SAVE / \"merged_segment_test.csv\")\n\n    non_feat = [\"Participant_ID\", \"PHQ_Binary\", \"PHQ_Score\", \"source\"]\n    mfc_feat_cols = [c for c in mfc_tr.columns if c not in non_feat]\n    w2v_feat_cols = [c for c in w2v_tr.columns if c not in non_feat]\n\n    train_df = w2v_tr.copy()\n    dev_df   = w2v_dv.copy()\n    test_df  = w2v_te.copy()\n    for col in mfc_feat_cols:\n        train_df[f\"mfc_{col}\"] = mfc_tr[col].values\n        dev_df[f\"mfc_{col}\"]   = mfc_dv[col].values\n        test_df[f\"mfc_{col}\"]  = mfc_te[col].values\nelse:\n    tr_file, dv_file, te_file = BASE_SETS[FEATURE_SET]\n    train_df = pd.read_csv(BASE_SAVE / tr_file)\n    dev_df   = pd.read_csv(BASE_SAVE / dv_file)\n    test_df  = pd.read_csv(BASE_SAVE / te_file)\n\nnon_feature_cols = [\"Participant_ID\", \"PHQ_Binary\", \"PHQ_Score\", \"source\"]\nfeature_cols = [c for c in train_df.columns if c not in non_feature_cols]\n\nX_traindev_df = pd.concat([train_df, dev_df], ignore_index=True)\nX_test_df     = test_df.copy()\n\nX_traindev_base = X_traindev_df[feature_cols].copy()\ny_traindev      = X_traindev_df[\"PHQ_Binary\"].values\n\nX_test_base = X_test_df[feature_cols].copy()\ny_test      = X_test_df[\"PHQ_Binary\"].values\n\nfeature_metadata = {\n    \"feature_set_name\": FEATURE_SET,\n    \"n_features\": len(feature_cols),\n    \"feature_columns\": feature_cols,\n    \"n_traindev_samples\": int(len(X_traindev_df)),\n    \"n_test_samples\": int(len(X_test_df)),\n    \"cv_splits\": N_SPLITS,\n    \"random_state\": RANDOM_STATE,\n}\nwith open(RESULTS_DIR / \"feature_metadata.json\", \"w\") as f:\n    json.dump(feature_metadata, f, indent=2)\n\nprint(f\"Feature set  : {FEATURE_SET}\")\nprint(f\"Features     : {len(feature_cols)}\")\nprint(f\"Train+Dev    : {len(X_traindev_df)} | Test: {len(X_test_df)}\")\nif \"source\" in train_df.columns:\n    print(f\"Sources      : {train_df['source'].value_counts().to_dict()}\")\nif \"PHQ_Binary\" in train_df.columns:\n    bal = X_traindev_df[\"PHQ_Binary\"].value_counts().to_dict()\n    print(f\"Class balance: {bal}\")\n"
  },
