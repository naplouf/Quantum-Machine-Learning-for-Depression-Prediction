   "source": [
    "from scipy.stats import wilcoxon\n",
    "\n",
    "sig_rows = []\n",
    "\n",
    "feature_groups_list = feature_ablation_df[\"feature_group\"].unique()\n",
    "\n",
    "for group_name in feature_groups_list:\n",
    "    # Compare QSVC raw_features vs SVM no balancing\n",
    "    qsvc_scores = feature_ablation_df[\n",
    "        (feature_ablation_df[\"model\"] == \"QSVC\") &\n",
    "        (feature_ablation_df[\"feature_group\"] == group_name) &\n",
    "        (feature_ablation_df[\"feature_pipeline\"] == \"raw_features\")\n",
    "    ][\"UAR\"].values\n",
    "\n",
    "    svm_scores = feature_ablation_df[\n",
    "        (feature_ablation_df[\"model\"] == \"SVM\") &\n",
    "        (feature_ablation_df[\"feature_group\"] == group_name) &\n",
    "        (feature_ablation_df[\"balancing\"] == \"none\")\n",
    "    ][\"UAR\"].values\n",
    "\n",
    "    if len(qsvc_scores) == len(svm_scores) and len(qsvc_scores) > 0:\n",
    "        stat, p = wilcoxon(qsvc_scores, svm_scores)\n",
    "\n",
    "        sig_rows.append({\n",
    "            \"feature_group\": group_name,\n",
    "            \"metric\": \"UAR\",\n",
    "            \"model_a\": \"QSVC_raw\",\n",
    "            \"model_b\": \"SVM_raw\",\n",
    "            \"model_a_mean\": np.mean(qsvc_scores),\n",
    "            \"model_b_mean\": np.mean(svm_scores),\n",
    "            \"statistic\": stat,\n",
    "            \"p_value\": p\n",
    "        })\n",
    "\n",
    "significance_ablation_df = pd.DataFrame(sig_rows)\n",
    "display(significance_ablation_df)\n",
    "\n",
    "significance_ablation_df.to_csv(ABLATION_SAVE_DIR / \"significance_tests_feature_ablation.csv\", index=False)\n",
    "print(\"Saved feature ablation significance tests.\")"
   ]
  },
