    "def fit_and_eval_classical_on_test(X_train_df, y_train, X_test_df, y_test, model, *, use_smote=False):\n",
    "    X_tr, y_tr_proc, X_te, artifacts = prepare_fold_data(\n",
    "        X_train_df, y_train, X_test_df,\n",
    "        use_smote=use_smote,\n",
    "        use_pca=False,\n",
    "        random_state=RANDOM_STATE\n",
    "    )\n",
    "    clf = clone(model)\n",
    "    clf.fit(X_tr, y_tr_proc)\n",
    "    preds = clf.predict(X_te)\n",
    "    metrics = compute_metrics(y_test, preds)\n",
    "    return metrics, preds\n",
    "\n",
    "def fit_and_eval_qsvc_on_test(X_train_df, y_train, X_test_df, y_test, *, top_k=6, reps=2, use_pca=False, balanced_subset_size=150):\n",
    "    X_tr_imp = SimpleImputer(strategy=\"mean\").fit_transform(X_train_df)\n",
    "    X_tr_std = StandardScaler().fit_transform(X_tr_imp)\n",
    "\n",
    "    rf_imp = RandomForestClassifier(\n",
    "        n_estimators=200,\n",
    "        class_weight=\"balanced\",\n",
    "        random_state=RANDOM_STATE,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "    rf_imp.fit(X_tr_std, y_train)\n",
    "\n",
    "    importance_df = pd.DataFrame({\n",
    "        \"feature\": X_train_df.columns,\n",
    "        \"importance\": rf_imp.feature_importances_\n",
    "    }).sort_values(\"importance\", ascending=False)\n",
    "\n",
    "    top_features = importance_df[\"feature\"].head(top_k).tolist()\n",
    "\n",
    "    X_train_sel_df = X_train_df[top_features]\n",
    "    X_test_sel_df = X_test_df[top_features]\n",
    "\n",
    "    X_tr_proc, y_tr_proc, X_te_proc, artifacts = prepare_fold_data(\n",
    "        X_train_sel_df, y_train, X_test_sel_df,\n",
    "        use_smote=False,\n",
    "        use_pca=use_pca,\n",
    "        n_components=top_k if use_pca else None,\n",
    "        scale_for_quantum=True,\n",
    "        random_state=RANDOM_STATE\n",
    "    )\n",
    "\n",
    "    X_tr_small, y_tr_small, chosen_idx = make_balanced_subset(\n",
    "        X_tr_proc, y_tr_proc,\n",
    "        max_total=balanced_subset_size,\n",
    "        random_state=RANDOM_STATE\n",
    "    )\n",
    "\n",
    "    feature_dim = X_tr_small.shape[1]\n",
    "    feature_map = ZZFeatureMap(feature_dimension=feature_dim, reps=reps)\n",
    "    quantum_kernel = FidelityQuantumKernel(feature_map=feature_map)\n",
    "    qsvc = QSVC(quantum_kernel=quantum_kernel)\n",
    "    qsvc.fit(X_tr_small, y_tr_small)\n",
    "\n",
    "    preds = qsvc.predict(X_te_proc)\n",
    "    metrics = compute_metrics(y_test, preds)\n",
    "\n",
    "    return metrics, preds, top_features\n",
    "\n",
    "test_rows = []\n",
    "\n",
    "for model_name, model in [\n",
    "    (\"SVM\", svm_model),\n",
    "    (\"Random Forest\", rf_model),\n",
    "    (\"Logistic Regression\", lr_model)\n",
    "]:\n",
    "    metrics, preds = fit_and_eval_classical_on_test(\n",
    "        X_traindev_base, y_traindev, X_test_base, y_test, model, use_smote=False\n",
    "    )\n",
    "    test_rows.append({\n",
    "        \"model\": model_name,\n",
    "        \"balancing\": \"none\",\n",
    "        \"feature_pipeline\": \"raw_features\",\n",
    "        **metrics\n",
    "    })\n",
    "\n",
    "q_metrics_raw, q_preds_raw, q_features_raw = fit_and_eval_qsvc_on_test(\n",
    "    X_traindev_base, y_traindev, X_test_base, y_test,\n",
    "    top_k=6, reps=2, use_pca=False, balanced_subset_size=150\n",
    ")\n",
    "test_rows.append({\n",
    "    \"model\": \"QSVC\",\n",
    "    \"balancing\": \"manual_balanced_subset\",\n",
    "    \"feature_pipeline\": \"raw_features\",\n",
    "    **q_metrics_raw,\n",
    "    \"selected_features\": \",\".join(q_features_raw)\n",
    "})\n",
    "\n",
    "q_metrics_pca, q_preds_pca, q_features_pca = fit_and_eval_qsvc_on_test(\n",
    "    X_traindev_base, y_traindev, X_test_base, y_test,\n",
    "    top_k=6, reps=2, use_pca=True, balanced_subset_size=150\n",
    ")\n",
    "test_rows.append({\n",
    "    \"model\": \"QSVC\",\n",
    "    \"balancing\": \"manual_balanced_subset\",\n",
    "    \"feature_pipeline\": \"raw_features_plus_pca\",\n",
    "    **q_metrics_pca,\n",
    "    \"selected_features\": \",\".join(q_features_pca)\n",
    "})\n",
    "\n",
    "test_results = pd.DataFrame(test_rows)\n",
    "test_results.to_csv(RESULTS_DIR / \"heldout_test_results.csv\", index=False)\n",
    "\n",
    "print(\"===== HELD-OUT TEST RESULTS =====\")\n",
    "test_results"
   ]
  },
