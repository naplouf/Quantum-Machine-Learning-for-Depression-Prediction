   "source": [
    "# Finalized E-DAIC Publication Pipeline\n",
    "\n",
    "This notebook version implements the following changes:\n",
    "\n",
    "1. Freezes one official feature set (raw volatility features from the enriched eGeMAPS files)\n",
    "2. Stops applying SMOTE globally before evaluation\n",
    "3. Moves scaling / SMOTE / PCA inside each fold\n",
    "4. Uses stratified cross-validation on train+dev, keeping test untouched\n",
    "5. Stores fold-level results\n",
    "6. Adds significance testing\n",
    "7. Keeps raw features as the official feature pipeline and uses PCA only as a model-specific option\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "28a87030",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import json\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy.stats import wilcoxon\n",
    "\n",
    "from sklearn.base import clone\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "from sklearn.preprocessing import StandardScaler, MinMaxScaler\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.metrics import accuracy_score, f1_score, recall_score\n",
    "from sklearn.svm import SVC\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "\n",
    "from imblearn.over_sampling import SMOTE\n",
    "\n",
    "from qiskit.circuit.library import ZZFeatureMap\n",
    "from qiskit_machine_learning.kernels import FidelityQuantumKernel\n",
    "from qiskit_machine_learning.algorithms import QSVC"
   ]
  },
