   "source": [
    "# =========================================================\n",
    "# COMBINE TRAIN + DEV FOR CROSS-VALIDATION\n",
    "# =========================================================\n",
    "\n",
    "train_dev_df = pd.concat([train_df, dev_df], ignore_index=True)\n",
    "\n",
    "X_full = train_dev_df[feature_cols].values\n",
    "y_full = train_dev_df[\"PHQ_Binary\"].values\n",
    "\n",
    "X_test_final = test_df[feature_cols].values\n",
    "y_test_final = test_df[\"PHQ_Binary\"].values\n",
    "\n",
    "print(\"Train+Dev shape:\", train_dev_df.shape)\n",
    "print(\"Test shape:\", test_df.shape)\n",
    "print(\"Number of features:\", len(feature_cols))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "47ff20b5",
   "metadata": {},
   "outputs": [],
   "source": "# =========================================================\n# FEATURE GROUP DEFINITIONS FOR ABLATION\n# Automatically adapts to whichever FEATURE_SET is loaded\n# =========================================================\n\nw2v_cols   = [c for c in feature_cols if c.startswith(\"w2v_\")]\nmfcc_cols  = [c for c in feature_cols if c.startswith(\"mfcc_\") or c.startswith(\"mfc_mfcc_\")]\negemap_cols = [c for c in feature_cols if c.startswith(\"egemap_\") or c.startswith(\"mfc_egemap_\")]\n\nif w2v_cols:\n    # wav2vec2 feature groups \u2014 split by volatility statistic type\n    FEATURE_GROUPS = {\n        \"w2v_seg_mean_std\"  : [c for c in w2v_cols if c.endswith(\"_seg_mean_std\")],\n        \"w2v_seg_trend\"     : [c for c in w2v_cols if c.endswith(\"_seg_trend\")],\n        \"w2v_global_std\"    : [c for c in w2v_cols if c.endswith(\"_global_std\")],\n        \"w2v_all\"           : w2v_cols,\n    }\n    if mfcc_cols:\n        FEATURE_GROUPS[\"mfcc_only\"]    = mfcc_cols\n        FEATURE_GROUPS[\"w2v_plus_mfcc\"] = w2v_cols + mfcc_cols\nelse:\n    # Fallback to original MFCC-based groups\n    FEATURE_GROUPS = {\n        \"mfcc_base_only\"  : [c for c in feature_cols if c.startswith(\"mfcc_base_\")],\n        \"mfcc_delta_only\" : [c for c in feature_cols if c.startswith(\"mfcc_delta_\") and not c.startswith(\"mfcc_delta2_\")],\n        \"mfcc_delta2_only\": [c for c in feature_cols if c.startswith(\"mfcc_delta2_\")],\n        \"egemap_only\"     : [c for c in feature_cols if c.startswith(\"egemap_\")],\n        \"mfcc_all\"        : [c for c in feature_cols if c.startswith(\"mfcc_\")],\n        \"mfcc_plus_egemap\": feature_cols.copy(),\n    }\n\n# Remove empty groups\nFEATURE_GROUPS = {k: v for k, v in FEATURE_GROUPS.items() if len(v) > 0}\n\nfor name, cols in FEATURE_GROUPS.items():\n    print(f\"{name}: {len(cols)} features\")\n"
  },
