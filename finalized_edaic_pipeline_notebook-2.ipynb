   "cell_type": "markdown",
   "id": "a2e0cd0c",
   "metadata": {},
   "source": [
    "## 2. Helper functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d4af442d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_classical_models(random_state=42):\n",
    "    return {\n",
    "        \"SVM\": SVC(C=10, kernel=\"rbf\", gamma=\"scale\", class_weight=\"balanced\", random_state=random_state),\n",
    "        \"Random Forest\": RandomForestClassifier(\n",
    "            n_estimators=200,\n",
    "            class_weight=\"balanced\",\n",
    "            random_state=random_state,\n",
    "            n_jobs=-1\n",
    "        ),\n",
    "        \"Logistic Regression\": LogisticRegression(\n",
    "            class_weight=\"balanced\",\n",
    "            max_iter=2000,\n",
    "            random_state=random_state\n",
    "        )\n",
    "    }\n",
    "def compute_metrics(y_true, y_pred):\n",
    "    return {\n",
    "        \"accuracy\": accuracy_score(y_true, y_pred),\n",
    "        \"UAR\": recall_score(y_true, y_pred, average=\"macro\"),\n",
    "        \"F1\": f1_score(y_true, y_pred, average=\"weighted\")\n",
    "    }\n",
    "\n",
    "def make_balanced_subset(X, y, max_total_samples=150, random_state=42):\n",
    "    rng = np.random.default_rng(random_state)\n",
    "\n",
    "    idx0 = np.where(y == 0)[0]\n",
    "    idx1 = np.where(y == 1)[0]\n",
    "\n",
    "    n_per_class = min(len(idx0), len(idx1), max_total_samples // 2)\n",
    "\n",
    "    chosen0 = rng.choice(idx0, size=n_per_class, replace=False)\n",
    "    chosen1 = rng.choice(idx1, size=n_per_class, replace=False)\n",
    "\n",
    "    chosen = np.concatenate([chosen0, chosen1])\n",
    "    rng.shuffle(chosen)\n",
    "\n",
    "    return X[chosen], y[chosen]\n",
    "\n",
    "def prepare_fold_data(\n",
    "    X_train_fold,\n",
    "    y_train_fold,\n",
    "    X_val_fold,\n",
    "    *,\n",
    "    use_smote=False,\n",
    "    use_pca=False,\n",
    "    n_components=None,\n",
    "    random_state=42\n",
    "):\n",
    "    # Scale inside fold\n",
    "    scaler = StandardScaler()\n",
    "    X_train_proc = scaler.fit_transform(X_train_fold)\n",
    "    X_val_proc = scaler.transform(X_val_fold)\n",
    "\n",
    "    # SMOTE only on training fold\n",
    "    if use_smote:\n",
    "        smote = SMOTE(random_state=random_state)\n",
    "        X_train_proc, y_train_fold = smote.fit_resample(X_train_proc, y_train_fold)\n",
    "\n",
    "    # PCA only if requested\n",
    "    pca = None\n",
    "    if use_pca:\n",
    "        if n_components is None:\n",
    "            raise ValueError(\"n_components must be set when use_pca=True\")\n",
    "        pca = PCA(n_components=n_components, random_state=random_state)\n",
    "        X_train_proc = pca.fit_transform(X_train_proc)\n",
    "        X_val_proc = pca.transform(X_val_proc)\n",
    "\n",
    "    return X_train_proc, y_train_fold, X_val_proc, scaler, pca"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c02ddccf",
   "metadata": {},
   "source": [
    "## 3. Cross-validation for classical models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "ac7e5674",
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_classical_cv(X_df, y, model_name, model, *, use_smote=False, n_splits=5, random_state=42):\n",
    "    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=random_state)\n",
    "    rows = []\n",
    "\n",
    "    for fold, (tr_idx, va_idx) in enumerate(skf.split(X_df, y), start=1):\n",
    "        X_tr_df = X_df.iloc[tr_idx]\n",
    "        X_va_df = X_df.iloc[va_idx]\n",
    "        y_tr = y[tr_idx]\n",
    "        y_va = y[va_idx]\n",
    "\n",
    "        X_tr, y_tr_proc, X_va, artifacts = prepare_fold_data(\n",
    "            X_tr_df, y_tr, X_va_df,\n",
    "            use_smote=use_smote,\n",
    "            use_pca=False,\n",
    "            random_state=random_state + fold\n",
    "        )\n",
    "\n",
    "        clf = clone(model)\n",
    "        clf.fit(X_tr, y_tr_proc)\n",
    "        preds = clf.predict(X_va)\n",
    "\n",
    "        metrics = compute_metrics(y_va, preds)\n",
    "        rows.append({\n",
    "            \"model\": model_name,\n",
    "            \"fold\": fold,\n",
    "            \"balancing\": \"SMOTE\" if use_smote else \"none\",\n",
    "            \"feature_pipeline\": \"raw_features\",\n",
    "            \"accuracy\": metrics[\"accuracy\"],\n",
    "            \"UAR\": metrics[\"UAR\"],\n",
    "            \"F1\": metrics[\"F1\"],\n",
    "            \"n_train_fold\": len(tr_idx),\n",
    "            \"n_val_fold\": len(va_idx)\n",
    "        })\n",
    "\n",
    "    return pd.DataFrame(rows)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f4c3eb2e",
   "metadata": {},
   "source": [
    "## 4. Cross-validation for QSVC"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1a14d890",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def run_qsvc_on_fold(\n",
    "    X_train_fold,\n",
    "    y_train_fold,\n",
    "    X_val_fold,\n",
    "    y_val_fold,\n",
    "    feature_names,\n",
    "    top_k=6,\n",
    "    reps=2,\n",
    "    use_pca=False,\n",
    "    random_state=42,\n",
    "    max_train_samples=150\n",
    "):\n",
    "    # Balanced subset only for QSVC\n",
    "    X_train_bal, y_train_bal = make_balanced_subset(\n",
    "        X_train_fold, y_train_fold,\n",
    "        max_total_samples=max_train_samples,\n",
    "        random_state=random_state\n",
    "    )\n",
    "\n",
    "    # Feature selection inside fold using RF importance\n",
    "    rf_imp = RandomForestClassifier(\n",
    "        n_estimators=200,\n",
    "        class_weight=\"balanced\",\n",
    "        random_state=random_state,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "    rf_imp.fit(X_train_bal, y_train_bal)\n",
    "\n",
    "    importance_order = np.argsort(rf_imp.feature_importances_)[::-1]\n",
    "    selected_idx = importance_order[:min(top_k, X_train_bal.shape[1])]\n",
    "    selected_features = [feature_names[i] for i in selected_idx]\n",
    "\n",
    "    X_train_sel = X_train_bal[:, selected_idx]\n",
    "    X_val_sel = X_val_fold[:, selected_idx]\n",
    "\n",
    "    # Standard scaling inside fold\n",
    "    scaler = StandardScaler()\n",
    "    X_train_scaled = scaler.fit_transform(X_train_sel)\n",
    "    X_val_scaled = scaler.transform(X_val_sel)\n",
    "\n",
    "    # Optional PCA for QSVC only\n",
    "    if use_pca:\n",
    "        n_components = min(top_k, X_train_scaled.shape[1])\n",
    "        pca = PCA(n_components=n_components, random_state=random_state)\n",
    "        X_train_scaled = pca.fit_transform(X_train_scaled)\n",
    "        X_val_scaled = pca.transform(X_val_scaled)\n",
    "\n",
    "    # Quantum scaling to [0, pi]\n",
    "    qscaler = MinMaxScaler(feature_range=(0, np.pi))\n",
    "    X_train_q = qscaler.fit_transform(X_train_scaled)\n",
    "    X_val_q = qscaler.transform(X_val_scaled)\n",
    "\n",
    "    feature_dimension = X_train_q.shape[1]\n",
    "\n",
    "    feature_map = ZZFeatureMap(\n",
    "        feature_dimension=feature_dimension,\n",
    "        reps=reps\n",
    "    )\n",
    "    quantum_kernel = FidelityQuantumKernel(feature_map=feature_map)\n",
    "\n",
    "    # Tune C lightly inside fold\n",
    "    best_model = None\n",
    "    best_uar = -1\n",
    "    best_c = None\n",
    "\n",
    "    for C in [0.1, 1, 10, 100]:\n",
    "        model = QSVC(quantum_kernel=quantum_kernel, C=C)\n",
    "        model.fit(X_train_q, y_train_bal)\n",
    "        preds = model.predict(X_val_q)\n",
    "        uar = recall_score(y_val_fold, preds, average=\"macro\")\n",
    "\n",
    "        if uar > best_uar:\n",
    "            best_uar = uar\n",
    "            best_model = model\n",
    "            best_c = C\n",
    "\n",
    "    final_preds = best_model.predict(X_val_q)\n",
    "    metrics = compute_metrics(y_val_fold, final_preds)\n",
    "\n",
    "    return metrics, selected_features, best_c"
   ]
  },
