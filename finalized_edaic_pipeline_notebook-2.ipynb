   "source": [
    "from sklearn.model_selection import StratifiedKFold\n",
    "import pandas as pd\n",
    "\n",
    "# =========================================================\n",
    "# FEATURE ABLATION EXPERIMENTS\n",
    "# =========================================================\n",
    "\n",
    "RANDOM_STATE = 42\n",
    "N_SPLITS = 5\n",
    "\n",
    "X_full = train_dev_df[feature_cols].values\n",
    "y_full = train_dev_df[\"PHQ_Binary\"].values\n",
    "\n",
    "feature_ablation_results = []\n",
    "\n",
    "skf = StratifiedKFold(n_splits=N_SPLITS, shuffle=True, random_state=RANDOM_STATE)\n",
    "\n",
    "for group_name, group_features in FEATURE_GROUPS.items():\n",
    "    print(f\"\\n===== Running feature group: {group_name} ({len(group_features)} features) =====\")\n",
    "\n",
    "    group_idx = [feature_cols.index(f) for f in group_features]\n",
    "    X_group = X_full[:, group_idx]\n",
    "\n",
    "    # ---------- Classical models ----------\n",
    "    for model_name, model in get_classical_models(random_state=RANDOM_STATE).items():\n",
    "        for balancing in [\"none\", \"SMOTE\"]:\n",
    "            for fold_idx, (train_idx, val_idx) in enumerate(skf.split(X_group, y_full), start=1):\n",
    "                X_train_fold = X_group[train_idx]\n",
    "                y_train_fold = y_full[train_idx]\n",
    "                X_val_fold = X_group[val_idx]\n",
    "                y_val_fold = y_full[val_idx]\n",
    "\n",
    "                X_train_proc, y_train_proc, X_val_proc, _, _ = prepare_fold_data(\n",
    "                    X_train_fold,\n",
    "                    y_train_fold,\n",
    "                    X_val_fold,\n",
    "                    use_smote=(balancing == \"SMOTE\"),\n",
    "                    use_pca=False,\n",
    "                    random_state=RANDOM_STATE\n",
    "                )\n",
    "\n",
    "                model.fit(X_train_proc, y_train_proc)\n",
    "                preds = model.predict(X_val_proc)\n",
    "                metrics = compute_metrics(y_val_fold, preds)\n",
    "\n",
    "                feature_ablation_results.append({\n",
    "                    \"fold\": fold_idx,\n",
    "                    \"model\": model_name,\n",
    "                    \"balancing\": balancing,\n",
    "                    \"feature_group\": group_name,\n",
    "                    \"feature_pipeline\": \"raw_features\",\n",
    "                    \"accuracy\": metrics[\"accuracy\"],\n",
    "                    \"UAR\": metrics[\"UAR\"],\n",
    "                    \"F1\": metrics[\"F1\"],\n",
    "                    \"selected_features\": \",\".join(group_features)\n",
    "                })\n",
    "\n",
    "    # ---------- Quantum models ----------\n",
    "    for use_pca in [False, True]:\n",
    "        pipeline_name = \"raw_features_plus_pca\" if use_pca else \"raw_features\"\n",
    "\n",
    "        for fold_idx, (train_idx, val_idx) in enumerate(skf.split(X_group, y_full), start=1):\n",
    "            X_train_fold = X_group[train_idx]\n",
    "            y_train_fold = y_full[train_idx]\n",
    "            X_val_fold = X_group[val_idx]\n",
    "            y_val_fold = y_full[val_idx]\n",
    "\n",
    "            metrics, selected_features, best_c = run_qsvc_on_fold(\n",
    "                X_train_fold=X_train_fold,\n",
    "                y_train_fold=y_train_fold,\n",
    "                X_val_fold=X_val_fold,\n",
    "                y_val_fold=y_val_fold,\n",
    "                feature_names=group_features,\n",
    "                top_k=min(6, len(group_features)),\n",
    "                reps=2,\n",
    "                use_pca=use_pca,\n",
    "                random_state=RANDOM_STATE,\n",
    "                max_train_samples=150\n",
    "            )\n",
    "\n",
    "            feature_ablation_results.append({\n",
    "                \"fold\": fold_idx,\n",
    "                \"model\": \"QSVC\",\n",
    "                \"balancing\": \"manual_balanced_subset\",\n",
    "                \"feature_group\": group_name,\n",
    "                \"feature_pipeline\": pipeline_name,\n",
    "                \"accuracy\": metrics[\"accuracy\"],\n",
    "                \"UAR\": metrics[\"UAR\"],\n",
    "                \"F1\": metrics[\"F1\"],\n",
    "                \"selected_features\": \",\".join(selected_features),\n",
    "                \"best_C\": best_c\n",
    "            })\n",
    "\n",
    "feature_ablation_df = pd.DataFrame(feature_ablation_results)\n",
    "feature_ablation_df.head()"
   ]
  },
  {
