   "source": [
    "RANDOM_STATE = 42\n",
    "N_SPLITS = 5\n",
    "\n",
    "BASE_SAVE = Path.home() / path,
    "RESULTS_DIR = BASE_SAVE / \"publication_results\"\n",
    "RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(\"BASE_SAVE:\", BASE_SAVE)\n",
    "print(\"RESULTS_DIR:\", RESULTS_DIR)"
   ]
